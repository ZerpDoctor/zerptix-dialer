# ==========================================================================
# Zerptix AI Dialer -- environment configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ==========================================================================

# --- Telephony provider ------------------------------------------------------
# Which provider actually places calls / owns the active webhook contract.
# "signalwire" (current) or "twilio" (kept intact behind this switch in case
# Twilio's compliance review ever clears -- the Twilio section below is only
# read when this is "twilio").
TELEPHONY_PROVIDER=signalwire

# --- SignalWire ---------------------------------------------------------------
# Dashboard -> API -- Space name (no scheme), e.g. your-space.signalwire.com
SIGNALWIRE_SPACE_URL=your-space.signalwire.com
# Dashboard -> API Credentials -- Project ID (this is the "AccountSid" on the
# Twilio-compatible REST surface).
SIGNALWIRE_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Dashboard -> API Credentials -- API Token.
SIGNALWIRE_API_TOKEN=your_signalwire_api_token
# The SignalWire number you will dial FROM, E.164 format.
SIGNALWIRE_FROM_NUMBER=+1XXXXXXXXXX
# Optional number pool: comma-separated E.164 numbers the scheduler round-robins
# calls across (each still respecting the eligibility rules below). Falls back
# to just [SIGNALWIRE_FROM_NUMBER] when left blank -- a single-number setup
# needs nothing here.
SIGNALWIRE_FROM_NUMBERS=
# Per-number nightly cap override, "number:cap,number:cap,...". A pool number
# without an entry here falls back to SCHED_NIGHTLY_CAP as its default.
SIGNALWIRE_NIGHTLY_CAPS=
# Dashboard -> API Credentials -- "Signing Key" (click Show). This is a
# SEPARATE secret from the API Token above -- it signs webhooks, the API Token
# does not. Without this, every inbound webhook fails signature verification.
SIGNALWIRE_SIGNING_KEY=your_signalwire_signing_key
# Verify every inbound SignalWire webhook against the X-SignalWire-Signature
# header (same HMAC-SHA1 scheme as Twilio's, just this secret + this header).
# Keep this `true`. Set to `false` ONLY for local debugging without a tunnel.
SIGNALWIRE_VALIDATE_SIGNATURE=true

# --- Twilio (kept intact; only used when TELEPHONY_PROVIDER=twilio) ----------
# From https://console.twilio.com  (Account Info panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# The Twilio number you will dial FROM, in E.164 format (e.g. +14155550123)
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Verify every inbound Twilio webhook against the X-Twilio-Signature header.
# Keep this `true`. Set to `false` ONLY for local debugging without a tunnel.
TWILIO_VALIDATE_SIGNATURE=true

# --- Public URL -------------------------------------------------------------
# The HTTPS base URL your telephony provider can reach this service at. No
# trailing slash. Local dev: run `ngrok http 8080` and paste the https URL it
# prints (or use the cloudflared quick tunnel -- see README).
# Railway:   your service's public domain, e.g. https://zerptix-dialer.up.railway.app
PUBLIC_BASE_URL=https://your-tunnel-or-railway-domain

# --- Google Sheets (keyless OAuth, authenticates as your Google user) --------
# Create an OAuth client:
#   Google Cloud Console -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Application type: "Desktop app"
# Then run:  python scripts/get_google_refresh_token.py
# and paste the refresh token it prints below.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token_from_the_helper_script
# Full URL of the Google Sheet (or just the spreadsheet ID). You must be an
# editor of this Sheet with the Google account you consent as.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXXXXXXXXXXXXXXXXXX/edit
# Tab (worksheet) name to append call results to. Created if missing.
GOOGLE_SHEET_TAB=Calls

# --- Anthropic --------------------------------------------------------------
# Used for one cheap classification call per detected IVR menu ("which digit?").
# If the call fails, the dialer logs "ANTHROPIC API ERROR (check billing / key)"
# and falls back to keyword-priority digit selection -- it does not guess or
# treat it as a code bug.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Dialer behaviour ------------------------------------------------------
# HARD test guard. While `true`, the dialer refuses to call any number that is
# not in TEST_ALLOWLIST. Do not set to `false` until you are ready for real
# prospects.
TEST_MODE=true
# Comma-separated E.164 numbers allowed to be dialed while TEST_MODE=true.
TEST_ALLOWLIST=+1XXXXXXXXXX

# Answering Machine Detection mode (same param name on both providers):
# "Enable" (fast, human/machine at pickup) or "DetectMessageEnd" (waits for
# the full greeting; slower).
MACHINE_DETECTION=Enable
# Seconds the answered call is held open (via TwiML <Pause>) to let async AMD
# resolve before we hang up. 6 is fine for MACHINE_DETECTION=Enable.
AMD_WAIT_SECONDS=6
# Record calls? Recording raises call-recording-consent questions (spec 12).
# Left off for the first core-loop test. Set to `true` deliberately.
# Recommended ON once you start IVR testing so wrong-digit / premature-hangup
# issues can be diagnosed from the audio (spec section 8).
RECORD_CALLS=false

# Port the local web server listens on.
PORT=8080

# --- IVR menu navigation (spec sections 3-4) --------------------------------
# Master switch. false -> calls skip menu navigation entirely and behave like
# the original core loop (pause, let AMD resolve, hang up).
IVR_ENABLED=true
# Single budget covering IVR navigation AND hold detection combined (seconds).
IVR_MASTER_TIMEOUT_SECONDS=60
# Max <Gather> cycles before we stop "listening through" non-menu speech.
IVR_MAX_GATHER_CYCLES=5
# Twilio speech model: "phone_call" (default) or "numbers_and_commands" /
# "experimental_conversations". "phone_call" is fine and cheapest.
IVR_SPEECH_MODEL=phone_call
# Seconds to wait for speech to start on the first listen.
IVR_INITIAL_TIMEOUT_SECONDS=5
# Seconds to wait for speech on follow-up / post-navigation listens.
IVR_TAIL_GATHER_SECONDS=5
# Kill switch for "digital gatekeeping" detection (an automated prompt asking
# for identifying info -- zip code, account number, name, reason for calling --
# with NO digit-press option; distinct from an IVR menu). Only ever consulted
# when the menu keyword gate has already said "not a menu", so a real
# digit-press option always takes priority. Outcome: gatekeeping_miss (same
# quarter effect as voicemail). Set false to disable instantly without a
# rollback if it misfires.
GATEKEEPING_DETECTION_ENABLED=true

# --- Scheduler / Sheet-as-queue (spec section 7) ---------------------------
# Tab holding per-company state (created by `python -m app.seed_queue`).
SCHED_QUEUE_TAB=Queue
# Separate tab the accelerated simulation writes to -- never your real data.
SCHED_SIM_QUEUE_TAB=Queue_SIM
# Calling windows in each company's LOCAL time (HH:MM-HH:MM).
SCHED_EVENING_WINDOW=21:30-22:30
SCHED_DEEP_NIGHT_WINDOW=02:00-04:00
# Calling days. A day owns its evening AND the 2-4am that follows it, so with
# Sun-Thu the deep-night clock times are Mon-Fri.
SCHED_CALLING_DAYS=Sun,Mon,Tue,Wed,Thu
# Minimum days between attempts to the same company (spec says 1-2 weeks).
SCHED_MIN_DAYS_BETWEEN_ATTEMPTS=10
# Hard cap on attempts per company per calendar quarter.
SCHED_MAX_ATTEMPTS_PER_QUARTER=4
# Window used for a company's first-ever attempt; then strictly alternates.
SCHED_FIRST_WINDOW=evening
# Seconds between ticks for `python -m app.scheduler run`.
SCHED_TICK_SECONDS=60
# Default nightly cap for any SIGNALWIRE_FROM_NUMBERS pool entry that has no
# override in SIGNALWIRE_NIGHTLY_CAPS (a single-number setup with no pool
# configured just uses this directly). 0 = unlimited. Process-lifetime count,
# resets daily (UTC). Simple launch stopgap -- NOT the full number-pool/ramp
# system with answer-rate-based ramping (spec section 10, a later task).
SCHED_NIGHTLY_CAP=0

# --- Inbound / callback number pool (spec sections 9-10) -------------------
# The dialer's callback numbers -- SEPARATE from TWILIO_FROM_NUMBER and from any
# real business number. Comma-separated E.164. Empty is fine for now.
# `python -m app.setup_inbound --apply` points every one of these at
# /inbound/voice, which <Reject>s the call (never answers, no audio, no content)
# and logs the attempt to the Inbound tab.
INBOUND_POOL_NUMBERS=
# Tab for the inbound-attempt log.
INBOUND_LOG_TAB=Inbound
# What a rejected caller hears: "rejected" (not-in-service / fast-busy) or "busy".
INBOUND_REJECT_REASON=rejected
